{
  "name": "inmoagent-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts && node scripts/copy-assets.mjs",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "format": "prettier --write apps packages tests *.ts *.json",
    "demo:api": "DATABASE_URL=postgres://inmo_app@127.0.0.1:55433/inmoagent tsx apps/api/src/server.ts",
    "demo:migrate": "MIGRATOR_URL=postgres://postgres@127.0.0.1:55433/postgres MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:55433/inmoagent tsx packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
